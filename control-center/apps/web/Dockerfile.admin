# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS build
WORKDIR /app
ARG SOURCE_COMMIT
RUN test -n "$SOURCE_COMMIT" && test ${#SOURCE_COMMIT} -eq 40
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
ARG VITE_ADMIN_ORIGIN=https://admin.opsworkbench.org
ENV VITE_ADMIN_ORIGIN=$VITE_ADMIN_ORIGIN
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci
COPY . .
RUN npm run build --workspace @control-center/shared
RUN npm run build --workspace @control-center/web

FROM nginx:1.27-alpine AS runtime
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
COPY deploy/nginx/admin-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -qO- http://127.0.0.1:8080/admin-healthz >/dev/null || exit 1
