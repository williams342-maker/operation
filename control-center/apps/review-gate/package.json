{
  "name": "@control-center/review-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:emit": "tsc -p tsconfig.emit-tests.json",
    "test:nospawn": "sh run-tests-nospawn.sh",
    "test": "node --experimental-test-module-mocks --import tsx --test test/*.test.ts",
    "operator": "node dist/operator.js",
    "pretest": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@control-center/shared": "file:../../packages/shared",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mongodb": "^6.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
