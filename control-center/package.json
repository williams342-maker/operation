{
  "name": "control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "pretest": "npm run build --workspace @control-center/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test deploy/scripts/*.test.mjs && npm run agent-bootstrap:test",
    "lint": "eslint .",
    "smoke:staging": "node deploy/scripts/staging-smoke.mjs",
    "test:e2e:authenticated": "node deploy/scripts/authenticated-e2e.mjs",
    "release:build": "bash scripts/build-release-artifacts.sh",
    "release:verify": "bash scripts/verify-release-artifacts.sh",
    "release-policy:validate": "npm run build --workspace @control-center/shared && node scripts/validate-release-policy.mjs",
    "release-policy:verify-publication": "npm run build --workspace @control-center/shared && node scripts/verify-publication-policy.mjs",
    "agent-bootstrap:build": "node scripts/build-agent-bootstrap.mjs",
    "agent-bootstrap:sign": "node scripts/sign-agent-bootstrap.mjs",
    "agent-bootstrap:verify": "node scripts/verify-agent-bootstrap.mjs",
    "agent-bootstrap:test": "node scripts/test-agent-bootstrap.mjs",
    "agent-bootstrap:build-disposable": "node scripts/build-disposable-agent-bootstrap.mjs",
    "agent-bootstrap:test-linux": "bash scripts/test-agent-bootstrap-linux.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "playwright": "^1.55.1",
    "typescript-eslint": "^8.64.0"
  }
}
