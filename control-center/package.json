{
  "name": "control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "pretest": "npm run build --workspace @control-center/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test deploy/scripts/*.test.mjs",
    "lint": "eslint .",
    "smoke:staging": "node deploy/scripts/staging-smoke.mjs",
    "test:e2e:authenticated": "node deploy/scripts/authenticated-e2e.mjs",
    "verify:shells": "node scripts/verify-shell-scripts.mjs",
    "deployment:archive": "node scripts/build-deployment-archive.mjs",
    "deployment:verify": "node scripts/verify-deployment-archive.mjs",
    "release:build": "bash scripts/build-release-artifacts.sh",
    "release:verify": "bash scripts/verify-release-artifacts.sh",
    "agent-bootstrap:build": "node scripts/build-agent-bootstrap.mjs",
    "agent-bootstrap:sign": "node scripts/sign-agent-bootstrap.mjs",
    "agent-bootstrap:verify": "node scripts/verify-agent-bootstrap.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "playwright": "^1.55.1",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "browserslist": "^4.28.8"
  }
}
