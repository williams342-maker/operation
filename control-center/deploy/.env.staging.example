# Copy to deploy/env/.env.staging on the staging host. Do not commit real values.
NODE_ENV=production
PORT=3000
MONGO_URL=mongodb://mongo:27017/control_center_staging
CONTROL_CENTER_DB=control_center_staging
CONTROL_CENTER_PUBLIC_URL=https://control.example.com
CONTROL_CENTER_WEB_ORIGIN=https://control.example.com
CONTROL_CENTER_TRUST_PROXY=loopback
CONTROL_CENTER_SECURE_COOKIES=true
CONTROL_CENTER_BOOTSTRAP_MODE=manual
CONTROL_CENTER_SESSION_SECRET=
CONTROL_CENTER_CSRF_SECRET=
CONTROL_CENTER_ENCRYPTION_KEY=
CONTROL_CENTER_EMAIL_LOGIN_WEBHOOK_URL=
CONTROL_CENTER_EMAIL_LOGIN_WEBHOOK_TOKEN=
CONTROL_CENTER_EMAIL_LOGIN_TTL_MINUTES=10
CONTROL_CENTER_PASSWORD_RESET_WEBHOOK_URL=
CONTROL_CENTER_PASSWORD_RESET_WEBHOOK_TOKEN=
CONTROL_CENTER_PASSWORD_RESET_TTL_MINUTES=30
AI_ASSISTANT_ENABLED=false
AI_ALLOWED_PROVIDERS=
AI_ALLOWED_MODELS=
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
AI_API_KEY=
AI_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_CONTEXT_BYTES=32768
AI_MAX_OUTPUT_TOKENS=1000
BUILD_VERSION=
GIT_COMMIT=
GIT_BRANCH=validation/discovery-hardening-linux
